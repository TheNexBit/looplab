# Dependencies and build output
node_modules/
dist/
# Rust builds go to the shared CARGO_TARGET_DIR; a local target/ must never appear
target/

# Tauri generated files and bundled sidecars
src-tauri/gen/
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep
# The tempo model (83 MB): scripts/10-modello-tempo.cmd installs it
src-tauri/models/

# Secrets
.env
.env.*
!.env.example

# Editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
*.log
Thumbs.db
.DS_Store
